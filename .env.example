# Environment Configuration Template (Copy to .env for local runtime)
# All parameters are injected at runtime; no secrets in repository.

# Application runtime
APP_ENV=development
SERVICE_NAME=securities-grievance-routing
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Declared Service Level Objectives (SLO) (Requirement D6)
SLO_P95_SECONDS=4.0
SLO_P50_SECONDS=1.5

# LLM Provider Configuration (Requirement A1, D6)
# Available options:
#   "stub"   - deterministic keyword rules (offline demos, CI, load tests; no AI)
#   "gemini" - Google Gemini (key from https://aistudio.google.com/apikey)
#   "openai" - OpenAI, or any OpenAI-compatible API via LLM_BASE_URL
#              (Groq: https://api.groq.com/openai/v1, local Ollama: http://localhost:11434/v1)
# If LLM_PROVIDER is gemini/openai but no key is set, the service logs a warning and uses the stub.
LLM_PROVIDER=stub
LLM_API_KEY=
# Leave empty for the provider default (gemini-flash-latest / gpt-4o-mini).
# If the default returns 503 "high demand", use gemini-flash-lite-latest.
LLM_MODEL=
LLM_BASE_URL=
# Client-side request cap for free tiers (0 = unlimited)
LLM_MAX_RPM=0
# Per-1M-token prices for cost accounting (set to your model's list price)
LLM_COST_PER_1M_INPUT=0.15
LLM_COST_PER_1M_OUTPUT=0.60
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=3

# Multi-Agent Orchestration & Loop Bounds (Requirement A1)
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=25.0

# Retrieval & Vector Index (Requirement L1, D2)
CORPUS_DIR=data/corpus
INDEX_DIR=data/index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4

# Caching & Rate Limiting (Requirement D7)
RATE_LIMIT_RPS=15.0
RATE_LIMIT_BURST=30
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Reliability & Circuit Breaker (Requirement A5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=4
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=15.0

# Observability (Requirement D5)
PROMETHEUS_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=false
OPENTELEMETRY_EXPORTER_ENDPOINT=http://jaeger:4317

# Queue / Task Runner (Requirement A4)
REDIS_URL=redis://redis:6379/0
USE_EMBEDDED_QUEUE=true

# Prompt Management (Requirement L2)
ACTIVE_PROMPT_VERSION=v2.0
